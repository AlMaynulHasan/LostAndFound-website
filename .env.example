# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=
CLOUDINARY_FOLDER=lost2found

# Session & Server Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=your-admin-email@campus.edu
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=Admin Name
ADMIN_STUDENT_ID=ADMIN-0001

# Email Configuration (Gmail SMTP)
MAIL_USER=your-gmail@gmail.com
MAIL_PASS=your-gmail-app-password

# Note: This project uses lowdb (JSON-based database)
# No database configuration needed!
# Data is automatically saved to: data/db.json
# To create an admin user, run: node scripts/create-admin.js

