<section class="page-hero">
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
    <div>
      <h1 class="mb-1">Lost Items</h1>
      <p class="text-muted mb-0">Browse lost item reports and help return them to their owners.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/items/report" class="btn btn-sun">Report Item</a>
    </div>
  </div>
</section>

<div class="filter-card p-4 mb-4">
  <form class="row g-3" method="get" action="/items/lost">
    <div class="col-md-4">
      <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input
          type="text"
          name="q"
          value="<%= filters.q || '' %>"
          class="form-control"
          placeholder="Search by item name or description"
        />
      </div>
    </div>
    <div class="col-md-2">
      <select name="category" class="form-select">
        <option value="">All categories</option>
        <option value="Phone" <%= filters.category === 'Phone' ? 'selected' : '' %>>Phone</option>
        <option value="Wallet" <%= filters.category === 'Wallet' ? 'selected' : '' %>>Wallet</option>
        <option value="Bag" <%= filters.category === 'Bag' ? 'selected' : '' %>>Bag</option>
        <option value="ID Card" <%= filters.category === 'ID Card' ? 'selected' : '' %>>ID Card</option>
        <option value="Books" <%= filters.category === 'Books' ? 'selected' : '' %>>Books</option>
        <option value="Electronics" <%= filters.category === 'Electronics' ? 'selected' : '' %>>Electronics</option>
        <option value="Others" <%= filters.category === 'Others' ? 'selected' : '' %>>Others</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="location" class="form-select">
        <option value="">All locations</option>
        <option value="Main Library" <%= filters.location === 'Main Library' ? 'selected' : '' %>>Main Library</option>
        <option value="Cafeteria" <%= filters.location === 'Cafeteria' ? 'selected' : '' %>>Cafeteria</option>
        <option value="Admin Block" <%= filters.location === 'Admin Block' ? 'selected' : '' %>>Admin Block</option>
        <option value="Department of CSE" <%= filters.location === 'Department of CSE' ? 'selected' : '' %>>Department of CSE</option>
        <option value="Department of ME" <%= filters.location === 'Department of ME' ? 'selected' : '' %>>Department of ME</option>
        <option value="Department of IPE" <%= filters.location === 'Department of IPE' ? 'selected' : '' %>>Department of IPE</option>
        <option value="Department of EEE" <%= filters.location === 'Department of EEE' ? 'selected' : '' %>>Department of EEE</option>
        <option value="Department of ICT" <%= filters.location === 'Department of ICT' ? 'selected' : '' %>>Department of ICT</option>
        <option value="Department of Civil" <%= filters.location === 'Department of Civil' ? 'selected' : '' %>>Department of Civil</option>
        <option value="Department of AIS" <%= filters.location === 'Department of AIS' ? 'selected' : '' %>>Department of AIS</option>
        <option value="Department of English" <%= filters.location === 'Department of English' ? 'selected' : '' %>>Department of English</option>
        <option value="Department of BBA" <%= filters.location === 'Department of BBA' ? 'selected' : '' %>>Department of BBA</option>
        <option value="Abbas Uddin Ahmed Hall" <%= filters.location === 'Abbas Uddin Ahmed Hall' ? 'selected' : '' %>>Abbas Uddin Ahmed Hall</option>
        <option value="Zikrul Haque Hall" <%= filters.location === 'Zikrul Haque Hall' ? 'selected' : '' %>>Zikrul Haque Hall</option>
        <option value="Taramon Bibi Hall" <%= filters.location === 'Taramon Bibi Hall' ? 'selected' : '' %>>Taramon Bibi Hall</option>
        <option value="Annex" <%= filters.location === 'Annex' ? 'selected' : '' %>>Annex</option>
        <option value="Central Field" <%= filters.location === 'Central Field' ? 'selected' : '' %>>Central Field</option>
        <option value="Seminal Hall" <%= filters.location === 'Seminal Hall' ? 'selected' : '' %>>Seminal Hall</option>
        <option value="Medical Center" <%= filters.location === 'Medical Center' ? 'selected' : '' %>>Medical Center</option>
        <option value="Parking Area" <%= filters.location === 'Parking Area' ? 'selected' : '' %>>Parking Area</option>
        <option value="Main Gate" <%= filters.location === 'Main Gate' ? 'selected' : '' %>>Main Gate</option>
        <option value="Sailar mor" <%= filters.location === 'Sailar mor' ? 'selected' : '' %>>Sailar mor</option>
        <option value="Other" <%= filters.location === 'Other' ? 'selected' : '' %>>Other</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="status" class="form-select">
        <option value="">Any status</option>
        <option value="reported" <%= filters.status === 'reported' ? 'selected' : '' %>>Reported</option>
        <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Returned</option>
      </select>
    </div>
    <div class="col-md-3">
      <input
        type="date"
        name="date"
        value="<%= filters.date || '' %>"
        class="form-control"
      />
    </div>
    <div class="col-md-3">
      <select name="sort" class="form-select">
        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest first</option>
        <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest first</option>
      </select>
    </div>
    <div class="col-md-3 d-grid">
      <button class="btn btn-primary" type="submit">
        <i class="bi bi-filter-circle me-1"></i>Apply filters
      </button>
    </div>
    <div class="col-md-3 d-grid">
      <a href="/items/lost" class="btn btn-ghost">Clear filters</a>
    </div>
  </form>
</div>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-3">
  <div>
    <h2 class="h5 mb-1">Results</h2>
    <p class="text-muted mb-0"><%= items.length %> items found</p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <% if (filters.category) { %><span class="tag">Category: <%= filters.category %></span><% } %>
    <% if (filters.type) { %><span class="tag">Type: <%= filters.type %></span><% } %>
    <% if (filters.status) { %><span class="tag">Status: <%= filters.status %></span><% } %>
    <% if (filters.location) { %><span class="tag">Location: <%= filters.location %></span><% } %>
  </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
  <% if (items && items.length) { %>
  <% items.forEach((item) => { %>
  <div class="col">
    <div class="item-card h-100 reveal">
      <div class="item-image">
        <% if (item.photoPath) { %>
        <img src="<%= item.photoPath %>" alt="Item photo" />
        <% } else { %>
        <div class="text-center text-muted">
          <i class="bi bi-camera" style="font-size: 2rem"></i>
          <div class="small mt-2">No photo provided</div>
        </div>
        <% } %>
      </div>
      <div class="item-body d-flex flex-column">
        <% const itemStatus = item.status || 'reported'; %>
        <div class="d-flex justify-content-between align-items-start">
          <h5 class="mb-0"><%= item.name %></h5>
          <span class="status-pill status-<%= item.type %>"><%= item.type %></span>
        </div>
        <p class="text-muted mb-2"><%= item.description ? item.description.slice(0, 90) : 'No description provided.' %></p>
        <div class="item-meta mt-auto">
          <div><i class="bi bi-geo-alt me-1"></i><%= item.location %></div>
          <div><i class="bi bi-calendar-event me-1"></i><%= new Date(item.createdAt).toLocaleDateString() %></div>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <span class="status-pill status-<%= itemStatus %>"><%= itemStatus === 'resolved' ? 'Returned' : itemStatus %></span>
          <a href="/items/<%= item.id %>" class="btn btn-sm btn-outline-primary">View details</a>
        </div>
      </div>
    </div>
  </div>
  <% }) %>
  <% } else { %>
  <div class="col">
    <div class="empty-state">No results found. Try adjusting your filters.</div>
  </div>
  <% } %>
</div>